# Tauri updater minisign. package:release also reads
# apps/desktop/src-tauri/.tauri-updater.key if this is unset.
# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Production Authenticode certificate thumbprint (CurrentUser\My or LocalMachine\My).
# If unset, package:release / pnpm sign:windows create a local CN=PaperMatrix self-signed cert.
# PIDECK_WINDOWS_CERT_THUMBPRINT=
# PIDECK_WINDOWS_TIMESTAMP_URL=http://timestamp.digicert.com
