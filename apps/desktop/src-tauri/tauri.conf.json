{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperMatrix",
  "mainBinaryName": "PaperMatrix",
  "version": "0.2.4",
  "identifier": "online.papermatrix.matrix-agent",
  "build": {
    "beforeDevCommand": "pnpm --filter @pideck/desktop dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --filter @pideck/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "PaperMatrix",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": true,
        "backgroundColor": "#111312"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://papermatrix.online; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "PaperMatrix",
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "resources": ["resources/pi-host", "resources/node", "resources/git"]
  },
  "plugins": {
    "shell": {
      "open": "https?://\\S+"
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxQzAxQ0E5QjY2MDVCMjYKUldRbVcyQzJxUnpBWWROajhTNVlYMStZNzNaWXNoZDBIb2JZa1NEYjBUK1pHdDlHOGY4clJlbnoK",
      "endpoints": ["https://papermatrix.online/api/updates/matrix-agent/latest.json"],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
